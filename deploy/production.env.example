# cms-web on the live server (the api repo's deploy/README.md, step 4). Copy to .env in this repo, then build.

# Where the website asks the API for sites and pages: on the same server, straight to the API's port.
# It is built in by `npm run build`, so a change needs a new build.
NEXT_PUBLIC_API_URL="http://127.0.0.1:4000"

# The same value as REVALIDATE_SECRET in the API's .env. Turns on caching the API's answers (CNT-08).
REVALIDATE_SECRET="<the API's REVALIDATE_SECRET>"
